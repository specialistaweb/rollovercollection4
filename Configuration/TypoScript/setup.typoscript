# Rollovercollection 4 - BLOCKS
# Requires bootstrap_package (content elements image, textpic, media, textmedia).

# Label of the "read more" button (layout MARIUCCI)
lib.rollovercollection4.label.readMore = TEXT
lib.rollovercollection4.label.readMore {
  value = READ MORE
  lang.it = DETTAGLI
}

# Partials of this extension are added on top of the bootstrap_package ones,
# but only for content elements using one of the BLOCKS layouts (tt_content.layout).
# Every other layout keeps the plain bootstrap_package rendering.
tt_content.image.partialRootPaths {
  2850 = EXT:rollovercollection4/Resources/Private/Partials/ContentElements/
  2850.stdWrap.if {
    value = 2851,2852,2853,2854,2855,2856,2857
    isInList.field = layout
  }
}
tt_content.textpic.partialRootPaths {
  2850 = EXT:rollovercollection4/Resources/Private/Partials/ContentElements/
  2850.stdWrap.if {
    value = 2851,2852,2853,2854,2855,2856,2857
    isInList.field = layout
  }
}
tt_content.media.partialRootPaths {
  2850 = EXT:rollovercollection4/Resources/Private/Partials/ContentElements/
  2850.stdWrap.if {
    value = 2851,2852,2853,2854,2855,2856,2857
    isInList.field = layout
  }
}
tt_content.textmedia.partialRootPaths {
  2850 = EXT:rollovercollection4/Resources/Private/Partials/ContentElements/
  2850.stdWrap.if {
    value = 2851,2852,2853,2854,2855,2856,2857
    isInList.field = layout
  }
}

# Settings handed over to the partials as {settings.R4...}
tt_content.image.settings {
  R4titleRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.titleRawdataOutput}
  R4captionRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.captionRawdataOutput}
  R4imageMaxWidth = {$plugin.tx_rollovercollection4_rollovereffect4.settings.imageMaxWidth}
}
tt_content.textpic.settings {
  R4titleRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.titleRawdataOutput}
  R4captionRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.captionRawdataOutput}
  R4imageMaxWidth = {$plugin.tx_rollovercollection4_rollovereffect4.settings.imageMaxWidth}
}
tt_content.media.settings {
  R4titleRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.titleRawdataOutput}
  R4captionRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.captionRawdataOutput}
  R4imageMaxWidth = {$plugin.tx_rollovercollection4_rollovereffect4.settings.imageMaxWidth}
}
tt_content.textmedia.settings {
  R4titleRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.titleRawdataOutput}
  R4captionRawdataOutput = {$plugin.tx_rollovercollection4_rollovereffect4.settings.captionRawdataOutput}
  R4imageMaxWidth = {$plugin.tx_rollovercollection4_rollovereffect4.settings.imageMaxWidth}
}

# Theme styles, compiled by the SCSS parser of bootstrap_package.
# The variables come from plugin.bootstrap_package.settings.scss.rollover4-*
page.includeCSS {
  rollovercollection4 = {$plugin.tx_rollovercollection4_rollovereffect4.view.scssPath}theme.scss
}
